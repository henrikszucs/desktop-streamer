{
    "name": "desktop-streamer",
    "version": "0.0.4",
    "description": "Free and open source screen sharing application for presentation, work, movies and gaming.",
    "scripts": {
        "server": "node ./src/server/server.js",
        "test": "node --test \"tests/**/*.test.js\"",
        "uninstall": "node ./src/uninstall.js"
    },
    "type": "module",
    "homepage": "https://github.com/henrikszucs/desktop-streamer",
    "author": {
        "name": "Henrik Szűcs",
        "url": "https://github.com/henrikszucs"
    },
    "bugs": {
        "url": "https://github.com/henrikszucs/desktop-streamer/issues"
    },
    "keywords": [
        "desktop",
        "stream",
        "remote",
        "screen",
        "share"
    ],
    "license": "AGPL-3.0-or-later",
    "dependencies": {
        "ajv": "^8.20.0",
        "better-sqlite3": "^13.0.3",
        "easy-communicator": "github:henrikszucs/easy-communicator#v1.2.0",
        "easy-control": "github:henrikszucs/easy-control#v0.9.0",
        "easy-idb": "github:henrikszucs/easy-idb#v1.0.0",
        "easy-mime": "github:henrikszucs/easy-mime#v1.1.0",
        "esbuild": "^0.28.2",
        "knex": "^3.1.0",
        "mysql2": "^3.24.2",
        "nodemailer": "^10.0.13",
        "ws": "^8.19.0"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "cpu": [
        "x64",
        "arm64"
    ],
    "allowScripts": {
        "better-sqlite3@13.0.3": true
    }
}
