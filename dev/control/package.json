{
    "name": "easy-control",
    "version": "0.14.0",
    "private": true,
    "description": "Simple and easy to use node.js module to simulate mouse, keyboard and controller input for Windows, MacOS and Linux.",
    "keywords": [
        "GUI",
        "control",
        "mouse",
        "keyboard",
        "controller",
        "emulator",
        "automation",
        "input",
        "nodejs",
        "native",
        "addon",
        "napi",
        "cross-platform",
        "windows",
        "macos",
        "linux"
    ],
    "license": "LGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/henrikszucs/easy-control"
    },
    "bugs": "https://github.com/henrikszucs/easy-control/issues",
    "maintainers": [
        {
            "name": "Henrik Szucs",
            "email": "henrikszucs6@gmail.com"
        }
    ],
    "scripts": {
        "build": "node index.js",
        "build:js": "node src/build.js",
        "build:gamepad": "node src/build-gamepad-win.js",
        "test": "node --test \"test/unit/*.test.js\"",
        "test:types": "tsc -p test/types",
        "test:native": "node test/native/run.js",
        "test:gamepad-stub": "node test/gamepad-stub/run.js",
        "test:mac": "node test/mac/run.js",
        "test:e2e": "node test/e2e/run.cjs",
        "test:driver": "node --test test/driver/driver.test.js",
        "clean": "node index.js --clean"
    },
    "engines": {
        "node": ">=22"
    },
    "type": "module",
    "gypfile": false,
    "main": "./dist/easy-control.cjs",
    "module": "./dist/easy-control.mjs",
    "types": "./dist/easy-control.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/easy-control.d.mts",
                "default": "./dist/easy-control.mjs"
            },
            "require": {
                "types": "./dist/easy-control.d.cts",
                "default": "./dist/easy-control.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "devDependencies": {
        "electron": "^44.5.1",
        "esbuild": "^0.28.2",
        "node-addon-api": "^8.5.0",
        "node-gyp": "^13.1.0",
        "typescript": "^7.0.2"
    }
}
