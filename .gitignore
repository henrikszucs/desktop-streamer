node_modules

# runtime folders: keep the folder in the repo, ignore its contents
tmp/*
!tmp/TEMPORARY_FOLDER
bin/*
!bin/PUT_BIN_HERE
conf/*
!conf/PUT_CONFIG_HERE
!conf/config.example.json

